      }
    },
    "Tap Edit to add songs, breaks and sets, drag to reorder, swipe to remove.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Bearbeiten, um Songs, Pausen und Sets hinzuzufügen; ziehen ordnet um, wischen entfernt."
          }
        }
      }
    },
    "Tap the right third of the screen for next, the left third for previous; or use the buttons at the bottom.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ins rechte Drittel für weiter, ins linke für zurück – oder nutze die Knöpfe unten."
          }
        }
      }
    },
    "Tap to close": {
      "localizations": {
        "de": {
          "stringUnit": {
