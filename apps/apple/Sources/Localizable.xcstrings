    "Import reads ChordPro, OnSong, OpenSong, text with chords over the lyrics, BandHelper exports, CSV and Cuebook libraries; paste takes a song or Ultimate Guitar links.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Import liest ChordPro, OnSong, OpenSong, Text mit Akkorden über dem Text, BandHelper-Exporte, CSV und Cuebook-Bibliotheken; Einfügen nimmt einen Song oder Ultimate-Guitar-Links."
          }
        }
      }
    },
    "Import reads ChordPro, OnSong, OpenSong, text with chords over the lyrics, BandHelper exports, CSV, Cuebook libraries, saved web links and pages; paste takes a song, Ultimate Guitar tab links or a playlist link. You can also drag links from Safari or files onto the song list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Import liest ChordPro, OnSong, OpenSong, Text mit Akkorden über dem Text, BandHelper-Exporte, CSV, Cuebook-Bibliotheken, gespeicherte Web-Links und -Seiten; Einfügen nimmt einen Song, Ultimate-Guitar-Tab-Links oder einen Playlist-Link. Du kannst auch Links aus Safari oder Dateien auf die Songliste ziehen."
          }
        }
      }
    },
    "Import, sync and safety": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Import, Abgleich und Sicherheit"
          }
        }
      }
    },
