    "Import reads ChordPro, OnSong, OpenSong, text with chords over the lyrics, BandHelper exports, CSV and Cuebook libraries; paste takes a song or Ultimate Guitar links.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Import liest ChordPro, OnSong, OpenSong, Text mit Akkorden über dem Text, BandHelper-Exporte, CSV und Cuebook-Bibliotheken; Einfügen nimmt einen Song oder Ultimate-Guitar-Links."
          }
        }
      }
    },
    "Import, sync and safety": {
